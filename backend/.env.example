DEVPILOT_APP_NAME=DevPilot API
DEVPILOT_ENVIRONMENT=development

# Local Docker Database:
DEVPILOT_DATABASE_URL=postgresql+asyncpg://devpilot:devpilot@localhost:5432/devpilot

# GCP Cloud SQL Database (Uncomment when connecting to GCP $300 Credit Project):
# DEVPILOT_DATABASE_URL=postgresql+asyncpg://devpilot:YOUR_GCP_PASSWORD@127.0.0.1:5432/devpilot

DEVPILOT_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Security & Authentication
DEVPILOT_SECRET_KEY=devpilot-enterprise-secure-jwt-secret-key-2026-replace-in-prod
DEVPILOT_ACCESS_TOKEN_EXPIRE_MINUTES=60
DEVPILOT_REFRESH_TOKEN_EXPIRE_DAYS=7
DEVPILOT_MAX_FAILED_ATTEMPTS=5
DEVPILOT_LOCKOUT_DURATION_MINUTES=15

# Local-only demo personas and fixture project. Keep false unless you want to
# seed the demo accounts. Set unique passwords before enabling.
DEVPILOT_DEMO_SEED_ENABLED=false
DEVPILOT_DEMO_ADMIN_PASSWORD=change-this-local-admin-password
DEVPILOT_DEMO_USER_PASSWORD=change-this-local-demo-password
